# naraacare-backend — copy to .env for local development. Dummy values only; nothing here is a real secret.
# Staging/prod: secrets come from the hosting provider's secret manager as environment variables (doc 08). No .env file exists there.
# Every key below is documented in README.md and docs/08-environment-and-config.md.

# --- app
APP_ENV=dev
APP_NAME=naraacare-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
API_DOCS_BASIC_AUTH=
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=

# --- database (app_rw; roles are created in database Session 02; locally a native PostgreSQL 18.6)
DATABASE_URL=postgresql+asyncpg://app_rw:local-dev-only-app-rw@localhost:5432/naraacare
DATABASE_REPLICA_URL=
DATABASE_SSL_MODE=disable
DATABASE_SSL_ROOT_CERT=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- redis: background worker queue only (the API does not use Redis; leave empty to run the API alone)
REDIS_URL=redis://127.0.0.1:6379/0?socket_connect_timeout=0.05&socket_timeout=0.05

# --- tokens. Dev: leave the keys empty and an ephemeral Ed25519 key is generated at start-up.
# Staging/prod: tools/new_jwt_key.py makes a key pair; both values live in the secret manager.
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=naraacare-mobile
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEYS_JSON=
JWT_ACTIVE_KID=k1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
LINK_TOKEN_TTL_SECONDS=600

# --- password hashing
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2

# --- object storage (dev: folders under STORAGE_ROOT_DIR)
STORAGE_ROOT_DIR=var/storage
STORAGE_CONTAINER_REPORTS=reports
STORAGE_CONTAINER_ATTACHMENTS=attachments

# --- email (dev: each message is written to EMAIL_OUTBOX_DIR as an .eml file, never logged)
EMAIL_OUTBOX_DIR=var/outbox
EMAIL_FROM_ADDRESS=nikettiwari9967@gmail.com
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nikettiwari9967@gmail.com
SMTP_PASSWORD=leav bbrg gqur iaal
SUPPORT_INBOX_ADDRESS=support@naraacare.local

# --- identity providers
GOOGLE_OAUTH_CLIENT_IDS=dummy-android.apps.googleusercontent.com,dummy-ios.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.naraacare.app.dev
APPLE_SERVICE_ID=com.naraacare.app.dev.siwa
APPLE_TEAM_ID=ABCDE12345
APPLE_SIWA_KEY_ID=DUMMYKEY01
APPLE_SIWA_PRIVATE_KEY_P8=dummy-not-a-key
# Provider endpoints (public keys for ID-token verification; Apple code exchange)
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token

# --- stores
GOOGLE_PLAY_PACKAGE_NAME=com.naraacare.app.dev
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"dummy"}
GOOGLE_RTDN_PUSH_AUDIENCE=http://localhost:8000/api/v1/billing/webhooks/google
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=rtdn@dummy-project.iam.gserviceaccount.com
APP_STORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_KEY_ID=DUMMYKEY02
APP_STORE_PRIVATE_KEY_P8=dummy-not-a-key
APP_STORE_ENVIRONMENT=Sandbox
APPLE_ROOT_CA_PATHS=certs/AppleRootCA-G3.cer

# --- push
FCM_SERVICE_ACCOUNT_JSON={"type":"dummy"}
FCM_API_BASE_URL=https://fcm.googleapis.com
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# --- Rin AI
RIN_ENABLED=true
OPENAI_API_KEY=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
RIN_MODEL=gpt-5-mini
RIN_EFFORT=low
RIN_MONTHLY_BUDGET_INR=10
AI_PRICE_INPUT_USD_PER_MTOK=0.25
AI_PRICE_CACHED_INPUT_USD_PER_MTOK=0.025
AI_PRICE_OUTPUT_USD_PER_MTOK=2.00
AI_USD_TO_INR=88
RIN_MAX_OUTPUT_TOKENS=2048

# --- misc integrations
# Staff routes (/admin/*) only answer from these networks (CIDR list). Empty = closed (404).
STAFF_IP_ALLOWLIST=127.0.0.1/32,::1/128

OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=NaraaCare/0.1 (support@naraacare.app)
REFERRAL_LINK_DOMAIN=naraacare.app

# --- limits
MAX_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10485760

# --- workers
WORKER_CONCURRENCY=10
