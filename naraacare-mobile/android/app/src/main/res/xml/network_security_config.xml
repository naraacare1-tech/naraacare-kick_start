<?xml version="1.0" encoding="utf-8"?>
<!-- staging + prod: HTTPS only, system CAs only (user-installed CAs are not trusted).
     Certificate pinning is enforced in Dart (dio) from Session 06. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
