# naraacare-mobile — NON-SECRET build configuration (doc 08 §4).
# Copy to env/dev.env, env/staging.env, env/prod.env (git-ignored) and build with:
#   flutter run --flavor dev -t lib/main_dev.dart --dart-define-from-file=env/dev.env
# Everything here ends up inside the app binary, so it must never contain a secret.

ENV_NAME=dev
# Must be https:// (dev may use http://10.0.2.2 or http://localhost for a local backend)
API_BASE_URL=http://10.0.2.2:8000/api/v1
WS_BASE_URL=ws://10.0.2.2:8000/api/v1/ws
# SPKI pins: current + backup (+ next). Required for staging/prod; empty allowed in dev only.
CERT_PINS=
GOOGLE_SERVER_CLIENT_ID=dummy-web.apps.googleusercontent.com
TERMS_URL=https://naraacare.app/terms
PRIVACY_URL=https://naraacare.app/privacy
