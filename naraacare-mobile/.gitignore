# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- NaraaCare additions (doc 08) ---
# Per-flavor build config (non-secret, but environment-specific); only the test file is committed
env/*.env
!env/test.env
.env
!.env.example
# Firebase / signing material — never commit
**/google-services.json
**/GoogleService-Info.plist
*.jks
*.keystore
android/key.properties
*.p8
*.p12
*.mobileprovision
# Obfuscation symbols (uploaded to Sentry by CI, never shipped)
build/symbols/
