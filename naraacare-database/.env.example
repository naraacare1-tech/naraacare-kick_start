# naraacare-database — copy to .env for local development. Dummy values only.
# In staging/prod these values come from the hosting provider's secret manager in the deploy job (never from a file).

PGHOST=localhost
PGPORT=5432
PGDATABASE=naraacare

# Flyway (native CLI 13.11.1; the tools/ scripts point it at the test database themselves)
FLYWAY_URL=jdbc:postgresql://localhost:5432/naraacare?sslmode=disable
FLYWAY_USER=migration_owner
FLYWAY_PASSWORD=local-dev-only-migration-owner
FLYWAY_LOCATIONS=filesystem:migrations,filesystem:seed,filesystem:functions,filesystem:procedures,filesystem:views,filesystem:triggers
FLYWAY_VALIDATE_MIGRATION_NAMING=true
FLYWAY_CLEAN_DISABLED=true

# Role passwords used by V003 (Session 02). Prod rotates them via the secret manager afterwards.
FLYWAY_PLACEHOLDERS_APP_RW_PASSWORD=local-dev-only-app-rw
FLYWAY_PLACEHOLDERS_APP_WORKER_PASSWORD=local-dev-only-app-worker
FLYWAY_PLACEHOLDERS_APP_READONLY_PASSWORD=local-dev-only-app-readonly
FLYWAY_PLACEHOLDERS_REPORTING_PASSWORD=local-dev-only-reporting

# Load DEVELOPMENT sample foods (approximate values). true for dev/staging, MUST be false in prod.
FLYWAY_PLACEHOLDERS_SEED_SAMPLE_FOODS=true

# Local PostgreSQL superuser (bootstrap and tests only; never used by apps)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# pgTAP test database
PGTAP_DATABASE=naraacare_test
